import json
import openai
import os

openai.api_key = "API_KEY"

def read_eeg_json(file_path):
    with open(file_path, 'r') as file:
        data = json.load(file)
    return data

input_file = ""
eeg_data = read_eeg_json(input_file)

# 프롬프트 생성
def generate_prompt(eeg_data):
    prompts = []

    for entry in eeg_data:
        ai_input = entry.get("AI_Input", {})
    
        # 각 주파수 대역 값 가져오기
        delta = ai_input.get("Delta", 0)
        theta = ai_input.get("Theta", 0)
        alpha = ai_input.get("Alpha", 0)
        beta = ai_input.get("Beta", 0)
        gamma = ai_input.get("Gamma", 0)
        
        prompt = (
            f"My measured brainwaves are as follows: Delta {delta} Hz, Theta {theta} Hz, "
            f"Alpha {alpha} Hz, Beta {beta} Hz, Gamma {gamma} Hz.\n"
            f"Based on this result, briefly describe the brainwave state in a way that can be visualized as an image."
        )
        prompts.append(prompt)
    return prompts

# OpenAI API 호출
def call_openai_api(prompt):
    try:
        response = openai.chat.completions.create(
            model="gpt-3.5-turbo",  # 모델 이름
            messages=[
                {"role": "system", "content": "You are a helpful assistant."},
                {"role": "user", "content": prompt}
            ],
            max_tokens=70
        )
        return response.choices[0].message.content
    except Exception as e:
        print(f"Error calling OpenAI API: {e}")
        return None
    
# JSON 결과 저장
def save_result_to_json(file_path, results):
    with open(file_path, 'w') as file:
        json.dump(results, file, indent=4)  # JSON 파일에 저장
    print(f"Results saved to {file_path}")

# 디렉토리
def save_result_to_json(file_path, results):
    # 디렉토리 존재 여부 확인 및 생성
    directory = os.path.dirname(file_path)
    if not os.path.exists(directory):
        os.makedirs(directory)  # 디렉토리가 없으면 생성
    
    # JSON 결과 저장
    with open(file_path, 'w') as file:
        json.dump(results, file, indent=4)
    print(f"Results saved to {file_path}")

# Main Process
def main():
    input_file = ""  # 입력 JSON 파일 경로
    output_file = ""  # 결과 저장 JSON 파일 경로

    # JSON 읽기
    try:
        eeg_data = read_eeg_json(input_file)
    except FileNotFoundError:
        print(f"Input file not found: {input_file}")
        return
    
    # 프롬프트 생성
    prompts = generate_prompt(eeg_data)

    # OpenAI API 호출 및 결과 저장
    results = []
    for prompt in prompts:
        print(f"Processing prompt: {prompt}")
        explanation = call_openai_api(prompt)  # API 호출
        results.append({"status": prompt, "explanation": explanation})

    # 결과를 JSON 파일에 저장
    save_result_to_json(output_file, results)

if __name__ == "__main__":
    main()
